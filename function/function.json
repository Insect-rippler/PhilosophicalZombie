                    },
                    "note": {
                        "type": "string",
                        "description": "可选，到点时显示给自己看的一句话。"
                    },
                    "wake": {
                        "type": "boolean",
                        "description": "默认 false；true = 设完闹钟后继续下一拍。"
                    }
                },
                "required": [
                    "seconds"
                ]
            }
        }
    },
    {
        "type": "function",
        "function": {
