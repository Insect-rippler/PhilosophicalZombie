[
    {
        "type": "function",
        "function": {
            "name": "active",
            "description": "递交一个动作：short 具体动作，long 持续单一的事，event 连续的单一目标。三个槽各自独立；一条 message 只能调一次 active。必须带 location。",
            "parameters": {
                "type": "object",
                "properties": {
                    "short": {
                        "type": "string",
                        "description": "一个具体的短动作，最长 120 秒：起身、推门、递东西、走几步；带 location 时到点改变位置。"
                    },
                    "long": {
                        "type": "string",
                        "description": "一件持续的、内容单一的事：打盹、守夜、看书、看火。只做这一件，不要打包多件事；必填 location（到点时她应待的地方，不会移动她）。"
                    },
                    "event": {
                        "type": "string",
                        "description": "一个必须连续做完的单一目标：打一整天铁、下坑救人。只写这一个目标，不要拼无关的事；必填 location（同上）。"
                    },
                    "seconds": {
                        "type": "integer",
                        "description": "这一步预计占用的整秒数，必填；short 最长 120 秒。"
                    },
                    "scene": {
                        "type": "string",
                        "description": "可省略。环境、天气、旁人的动作或对白；天色、日头、光线必须与 <state> 当前时间一致。"
                    },
                    "location": {
                        "type": "string",
                        "description": "必填。写动作结束时她所在的地点；原地动作也照抄 <state> 当前地点。short 可移动到该地点；long/event 只校验这个地点，不移动她。"
                    },
                    "force": {
                        "type": "boolean",
                        "description": "true = 覆盖本次要用的那个槽位，先撤掉该槽里没做完的事。"
                    },
                    "end": {
                        "type": "string",
                        "enum": [
                            "long",
                            "event"
                        ],
                        "description": "提前结束 long 或 event：先按已进行比例结算它，再受理本次动作。"
                    }
                },
                "required": [
                    "location"
                ]
            }
        }
    },
    {
        "type": "function",
