                        "enum": [
                            "general",
                            "news"
                        ]
                    },
                    "max_results": {
                        "type": "integer",
                        "description": "返回的最大搜索结果数量, 取值范围 1-20. 简单事实查询建议设为 3-5; 全面综述、对比分析或需要多来源交叉验证时建议设为 8-10. 默认值: 3. ",
                        "minimum": 1,
