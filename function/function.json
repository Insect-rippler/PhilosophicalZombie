    {
        "type": "function",
        "function": {
            "name": "map",
            "description": "她的地图。action=query 查当前地点到 target 的前三条路线；action=create 用 target/risk/time 新建相邻节点并连到当前地点；action=link 用 target/link/time 新建或修改两地连线。日常只有这三种；dream 才开放 unlink/set_risk/delete/merge。",
            "parameters": {
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "query",
                            "create",
                            "link",
                            "unlink",
                            "set_risk",
                            "delete",
                            "merge"
                        ],
                        "description": "query 查询；create 新建节点并连到当前；link 建/改连线；其余仅 dream。"
                    },
                    "target": {
                        "type": "string",
                        "description": "目标地点；create 时是新节点名。"
                    },
                    "risk": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3,
                        "description": "0 安全 / 1 正常 / 2 警戒 / 3 危险；create 时必填。"
                    },
                    "link": {
                        "type": "string",
                        "description": "另一个地点；link/unlink/merge 时用。"
                    },
                    "time": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "两地之间的预估秒数；create/link 时必填。"
                    }
                },
                "required": [
                    "action"
                ]
            }
        }
    }
