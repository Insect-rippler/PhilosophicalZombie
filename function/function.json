                            "chat",
                            "moments",
                            "diary"
                        ],
                        "description": "应用；默认 chat。"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "list 默认 8，最多 32。"
                    },
                    "query": {
                        "type": "string",
