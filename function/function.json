                    },
                    "tag": {
                        "type": "string",
                        "description": "涉及的人或事物，用于归类，例如「某个角色」「某件物品」。可省略。"
                    }
                },
                "required": [
                    "text"
                ]
            }
        },
        "path": "function/remember/remember.py"
    },
    {
        "type": "function",
        "function": {
            "name": "plan",
            "description": "记录并推进她想做的事。只要是跨不止一轮的打算，都记在这里：今天要做什么、做到哪一步、卡在哪。做完或放弃就更新状态。",
            "parameters": {
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "list",
                            "add",
                            "step_done",
                            "step_drop",
                            "revise",
                            "pause",
                            "resume",
                            "done",
                            "abandon"
                        ]
                    },
                    "goal": {
                        "type": "string",
                        "description": "目标 id，除 list/add 外必填。"
                    },
                    "objective": {
                        "type": "string",
                        "description": "add 时必填：要做成什么。"
                    },
                    "steps": {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "title": {
                                            "type": "string"
                                        },
                                        "fallback": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "title"
                                    ]
                                }
                            ]
                        },
                        "description": "add 时的步骤；可用字符串，或 {title, fallback}。revise 整体替换，配合 step 只替换那一步。"
                    },
                    "step": {
                        "type": "integer",
                        "description": "step_done 时必填：第几步。"
                    },
                    "note": {
                        "type": "string",
                        "description": "必填：为什么改 / 为什么放弃 / 这一步做成了什么；list 也要说明为什么查。"
                    }
                },
                "required": [
                    "action",
                    "note"
                ]
            }
        },
        "path": "function/plan/plan.py"
    },
    {
        "type": "function",
        "function": {
            "name": "alarm",
            "description": "设一个独立闹钟：到点提醒她，睡着就叫醒，醒着就提一句。和睡不睡无关；只保留一个，新的覆盖旧的。默认设完不唤醒，wake=true 时继续下一拍。",
