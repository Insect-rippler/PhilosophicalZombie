                    },
                    "enemy": {
                        "type": "string",
                        "description": "start 时必填：敌人 id，如 boar / hound / crystal_crawler。"
                    },
                    "skill": {
                        "type": "string",
                        "description": "act 时选技能 id；不填用普通攻击。"
                    }
                },
                "required": [
                    "action"
                ]
            }
        }
    },
    {
